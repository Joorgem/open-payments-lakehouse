{
  "datasets": [
    {
      "name": "ds_freshness",
      "displayName": "Bronze freshness against the declared cadence",
      "queryLines": [
        "SELECT source, source_freshness_status, cadence_kind, expected_every_days,\n",
        "  last_snapshot_month, last_source_date, source_age_days,\n",
        "  last_ingested_at, pipeline_age_days, bronze_rows, cadence_note\n",
        "FROM workspace.default.dataops_freshness\n",
        "ORDER BY source_freshness_status, source"
      ]
    },
    {
      "name": "ds_sql_coverage",
      "displayName": "Which task keys the platform records SQL for, and which it does not",
      "queryLines": [
        "SELECT task_key, sql_telemetry, COUNT(*) AS task_runs,\n",
        "  COUNT(read_rows) AS runs_with_a_row_count,\n",
        "  SUM(CASE WHEN read_rows = 0 THEN 1 WHEN read_rows > 0 THEN 0 END)\n",
        "    AS runs_reading_zero_rows,\n",
        "  MAX(execution_seconds) AS slowest_seconds\n",
        "FROM workspace.default.dataops_task_telemetry\n",
        "GROUP BY task_key, sql_telemetry\n",
        "ORDER BY sql_telemetry, task_runs DESC"
      ]
    },
    {
      "name": "ds_task_runs",
      "displayName": "Task runs, most recent first",
      "queryLines": [
        "SELECT started_at, job_name, task_key, attempt, result_state,\n",
        "  execution_seconds, sql_telemetry, statements, read_rows, written_rows,\n",
        "  written_bytes, run_id\n",
        "FROM workspace.default.dataops_task_telemetry\n",
        "ORDER BY started_at DESC\n",
        "LIMIT 200"
      ]
    }
  ],
  "pages": [
    {
      "name": "pg_dataops",
      "displayName": "DataOps",
      "layout": [
        {
          "widget": {
            "name": "wg_freshness",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_freshness",
                  "disaggregated": true,
                  "fields": [
                    { "name": "source", "expression": "`source`" },
                    { "name": "source_freshness_status", "expression": "`source_freshness_status`" },
                    { "name": "cadence_kind", "expression": "`cadence_kind`" },
                    { "name": "expected_every_days", "expression": "`expected_every_days`" },
                    { "name": "last_snapshot_month", "expression": "`last_snapshot_month`" },
                    { "name": "last_source_date", "expression": "`last_source_date`" },
                    { "name": "source_age_days", "expression": "`source_age_days`" },
                    { "name": "last_ingested_at", "expression": "`last_ingested_at`" },
                    { "name": "pipeline_age_days", "expression": "`pipeline_age_days`" },
                    { "name": "bronze_rows", "expression": "`bronze_rows`" },
                    { "name": "cadence_note", "expression": "`cadence_note`" }
                  ]
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "table",
              "encodings": {
                "columns": [
                  { "fieldName": "source", "displayName": "table" },
                  { "fieldName": "source_freshness_status", "displayName": "source freshness" },
                  { "fieldName": "cadence_kind", "displayName": "cadence" },
                  { "fieldName": "expected_every_days", "displayName": "expected every (days)" },
                  { "fieldName": "last_snapshot_month", "displayName": "snapshot month" },
                  { "fieldName": "last_source_date", "displayName": "source date" },
                  { "fieldName": "source_age_days", "displayName": "source age (days)" },
                  { "fieldName": "last_ingested_at", "displayName": "last ingested" },
                  { "fieldName": "pipeline_age_days", "displayName": "pipeline age (days) - no threshold" },
                  { "fieldName": "bronze_rows", "displayName": "rows" },
                  { "fieldName": "cadence_note", "displayName": "why" }
                ]
              },
              "frame": {
                "showTitle": true,
                "title": "Freshness - a paused table is a recorded decision, not a fault"
